{
  "name": "forgent",
  "version": "1.2.1",
  "description": "shadcn-style installer for AI agent skills. Pick from a remote registry and copy the skill folder where your harness reads it: .agents/skills (Codex, GitHub Copilot, Cursor, Gemini CLI, OpenCode, Kilo Code…) or .claude/skills (Claude Code). You own the copy.",
  "type": "module",
  "bin": {
    "forgent": "bin/forgent.js"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/forgent.js",
    "test": "node --test",
    "doctor": "node bin/forgent.js doctor",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "copilot",
    "codex",
    "cursor",
    "ai",
    "agent",
    "skills",
    "prompts",
    "shadcn",
    "registry",
    "agent-skills",
    "agentskills",
    "gemini-cli",
    "opencode",
    "kilo-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrincyExaltIT/forgent.git"
  },
  "homepage": "https://github.com/PrincyExaltIT/forgent#readme",
  "bugs": {
    "url": "https://github.com/PrincyExaltIT/forgent/issues"
  },
  "author": "PrincyExaltIT",
