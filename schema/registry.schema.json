{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PrincyExaltIT/forgent/main/schema/registry.schema.json",
  "title": "forgent registry manifest",
  "description": "Manifest describing a registry of AI agent skills installable via the forgent CLI.",
  "type": "object",
  "required": ["name", "version", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Registry identifier."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Registry version (semver)."
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["name", "files"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "description": { "type": "string" },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "description": "Reserved for future per-skill versioning (skill@version syntax). Not consumed by the runtime yet."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "file": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)(?!.*\\\\).+$",
          "description": "POSIX-style relative path; no leading slash, no drive letter, no .. segment, no backslash."
        },
        "type": {
          "enum": [
            "skill:main",
            "skill:doc",
            "skill:codex",
            "skill:copilot",
            "skill:example",
            "skill:reference",
            "skill:template"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase hex SHA256 of the UTF-8 encoded file content. If present, forgent verifies the fetched body matches before writing. Manifests without this field cause forgent >= 1.0 to error by default (strict mode); pass --no-strict-sha256 or set FORGENT_STRICT_SHA256=0 to fall back to a one-time WARN per skill."
        }
      }
    }
  }
}
